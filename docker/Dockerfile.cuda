# syntax=docker/dockerfile:1
#
# The CUDA 12 image, for linux/amd64. Build it with `make image-cuda`. It needs
# the NVIDIA Container Toolkit and `docker run --gpus all`.
#
#   BAKE_MODELS, WITH_ESPEAK, WITH_FFMPEG, VERSION: as in Dockerfile.cpu
#
# The base matches the tested baseline: ONNX Runtime 1.22.0 with CUDA 12.8 and
# cuDNN 9.

ARG ORT_VERSION=1.22.0
ARG GO_IMAGE=golang:1.27-bookworm
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

FROM ${GO_IMAGE} AS src
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .

# Built on Debian 12, whose glibc is older than the runtime's Ubuntu 24.04.
FROM src AS build
ARG VERSION=devel
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
	CGO_ENABLED=1 go build -trimpath -ldflags "-s -w -X github.com/androiddrew/kokoro-run/internal/cli.version=$VERSION" \
		-o /out/kokoro-run ./cmd/kokoro-run

FROM build AS models
ARG BAKE_MODELS=1
RUN set -eux; \
	mkdir /assets; \
	if [ "$BAKE_MODELS" = 1 ]; then \
		/out/kokoro-run pull --dir /assets; \
		cp /src/third_party/kokoro-82M-MODEL_CARD.md /assets/kokoro/MODEL_CARD.md; \
	fi

FROM ${GO_IMAGE} AS onnxruntime
ARG ORT_VERSION
ARG ORT_SHA256=2a19dbfa403672ec27378c3d40a68f793ac7a6327712cd0e8240a86be2b10c55
RUN set -eux; \
	curl -fsSL -o /ort.tgz "https://github.com/microsoft/onnxruntime/releases/download/v$ORT_VERSION/onnxruntime-linux-x64-gpu-$ORT_VERSION.tgz"; \
	echo "$ORT_SHA256  /ort.tgz" | sha256sum -c -; \
	mkdir /onnxruntime; \
	tar xzf /ort.tgz --no-same-owner --strip-components=1 -C /onnxruntime

FROM ${CUDA_IMAGE}
ARG ORT_VERSION
ARG VERSION=devel
ARG WITH_ESPEAK=0
ARG WITH_FFMPEG=1
LABEL org.opencontainers.image.title="kokoro-run" \
	org.opencontainers.image.description="OpenAI-compatible text-to-speech with Kokoro v1.0, on NVIDIA GPUs" \
	org.opencontainers.image.source="https://github.com/androiddrew/kokoro-run" \
	org.opencontainers.image.version="$VERSION" \
	org.opencontainers.image.licenses="Apache-2.0"
RUN set -eux; \
	packages=ca-certificates; \
	if [ "$WITH_FFMPEG" = 1 ]; then packages="$packages ffmpeg"; fi; \
	if [ "$WITH_ESPEAK" = 1 ]; then packages="$packages espeak-ng"; fi; \
	apt-get update; \
	apt-get install -y --no-install-recommends $packages; \
	rm -rf /var/lib/apt/lists/*; \
	useradd --uid 10001 --user-group --home-dir /var/lib/kokoro-run --no-create-home --shell /usr/sbin/nologin kokoro-run

# third_party/ includes the Kokoro-82M model card, whose license and training
# data attributions go with every copy of the model.
ARG DOCS=/usr/share/doc/kokoro-run
COPY LICENSE NOTICE THIRD_PARTY.md ASSETS.md $DOCS/
COPY third_party/ $DOCS/third_party/
COPY --from=onnxruntime /onnxruntime/LICENSE /onnxruntime/ThirdPartyNotices.txt $DOCS/onnxruntime/
RUN ln -s /NGC-DL-CONTAINER-LICENSE "$DOCS/NGC-DL-CONTAINER-LICENSE"

# The CUDA provider is loaded from beside libonnxruntime.
COPY --from=onnxruntime \
	/onnxruntime/lib/libonnxruntime.so.$ORT_VERSION \
	/onnxruntime/lib/libonnxruntime_providers_shared.so \
	/onnxruntime/lib/libonnxruntime_providers_cuda.so \
	/opt/onnxruntime/lib/
COPY docker/config.cuda.yaml /etc/kokoro-run/config.yaml
COPY --from=build /out/kokoro-run /usr/local/bin/kokoro-run
COPY --from=models --chown=kokoro-run:kokoro-run /assets /var/lib/kokoro-run/assets

ENV KOKORO_RUN_CONFIG=/etc/kokoro-run/config.yaml
USER kokoro-run
WORKDIR /var/lib/kokoro-run
EXPOSE 8880
VOLUME /var/lib/kokoro-run/assets
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s CMD ["kokoro-run", "_healthcheck"]
ENTRYPOINT ["kokoro-run"]
CMD ["serve"]
